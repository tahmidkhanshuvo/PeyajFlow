{
  "id": "peyajflow-freshness",
  "name": "PeyajFlow freshness",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "manual",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/automation/jobs/freshness",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({request_key: '00000000-0000-4000-8000-' + String(Math.floor(Date.now() / 86400000)).padStart(12, '0')}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "api",
      "name": "Run scoped job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "peyajflow-automation",
          "name": "PeyajFlow automation token"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Run scoped job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual test": {
      "main": [
        [
          {
            "node": "Run scoped job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka"
  },
  "tags": []
}
