# Local Docker Compose credentials. Use a separate database and secret in hosted environments.
POSTGRES_USER=peyajflow
POSTGRES_PASSWORD=peyajflow-local
POSTGRES_DB=peyajflow
POSTGRES_PORT=5432
API_PORT=8000

# Independent cost switches; disabling automation still permits opt-out/history.
AUTOMATION_ENABLED=true
OPERATOR_ASSISTANT_ENABLED=true
LOCAL_MODEL_PREVIEW_ENABLED=true
KNOWLEDGE_CACHE_ENABLED=true
KNOWLEDGE_CACHE_TTL_SECONDS=300
KNOWLEDGE_CACHE_MAX_ENTRIES=128
KNOWLEDGE_CHUNK_TOKENS=512
# Context generation always uses Ollama, independently of KNOWLEDGE_PROVIDER.
OLLAMA_CONTEXT_MODEL=qwen2.5:7b-instruct-q4_K_M
# Optional server-side Bearer credential for an authenticated HTTPS Ollama proxy.
OLLAMA_API_KEY=
