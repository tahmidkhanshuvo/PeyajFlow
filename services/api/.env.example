# Use this only for a host-native API talking to the local Compose database.
DATABASE_URL=postgresql+psycopg://peyajflow:peyajflow-local@127.0.0.1:5432/peyajflow
APP_ENV=development
DEMO_MODE=true
PHOTO_STORAGE=local
TELEPHONY_PROVIDER=disabled
SMS_PROVIDER=disabled
# Optional on a dedicated hosted portfolio database. Use 20 or more random characters.
SHOWCASE_ACCESS_KEY=
# Required for signed provider callbacks when a provider is enabled.
PUBLIC_API_ORIGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_GREETING_URL=
# Hosted photo storage uses PHOTO_STORAGE=s3 and a private bucket.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional model help for voice commands the grammar does not match and for
# transcription in browsers without speech recognition. Off unless enabled.
VOICE_MODEL_FALLBACK=false
VOICE_MODEL_PROVIDER=meta
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
VOICE_TRANSCRIPTION=false
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Public knowledge and local inference. Account records are never indexed.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_PROVIDER=extractive
EMBEDDING_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
GEMINI_EMBED_MODEL=gemini-embedding-001
MCP_API_BASE_URL=http://127.0.0.1:8000
# Opt in only to an artifact whose held-out improvement gate passed.
VOICE_DSPY_PROMPT_FILE=
